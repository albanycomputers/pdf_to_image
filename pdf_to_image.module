<?php
/**
 * Create images from PDF pages with configurable alt-text generation.
 */

/**
 * Implements hook_form_FORM_ID_alter() for field_ui_field_edit_form.
 */
function pdf_to_image_form_field_ui_field_edit_form_alter(&$form, &$form_state, $form_id) {
  $instance = $form['#instance'];

  // Add settings to just the generic File widget.
  if ($instance['widget']['type'] != 'file_generic') {
    return;
  }

  // Get default values.
  if (isset($instance['settings']['pdf_to_image'])) {
    $defaults = $instance['settings']['pdf_to_image'];
  }
  else {
    $defaults = array(
      'image_field' => '',
      'hide_image_field' => FALSE,
      'format' => 'jpg',
      'options' => array(
        'resolution' => 100,
        'trim' => FALSE,
      ),
    );
  }
  // Ensure default values are populated for new fields or older configurations.
  $defaults += array(
    'pdf_to_image_alt_mode' => 'none',
    'pdf_to_image_alt_token' => '[node:title]',
  );

  // Get image fields on this entity as options for the select field.
  $options = array();
  $fields = field_info_instances($instance['entity_type'], $instance['bundle']);
  foreach ($fields as $field) {
    $field_info = field_info_field($field['field_name']);
    if ($field_info['type'] == 'image') {
      $options[$field['field_name']] = $field['label'];
    }
  }

  // Display certain fields only when an image field has been selected.
  $states = array(
    'invisible' => array(
      ':input[name$="[pdf_to_image][image_field]"]' => array('value' => ''),
    ),
  );

  // Add our settings.
  $form['instance']['settings']['pdf_to_image'] = array(
    '#type' => 'fieldset',
    '#title' => t('PDF to image'),
    '#description' => t("When an image field is selected below, the PDF file uploaded to this field will have images of its page(s) saved to that image field. The number of images saved will be either: the number of pages in the PDF file, or the 'Number of values' allowed for the selected image field (whichever is less).<br>Note that if this is a multi-valued field (determined by the 'Number of values' global setting below) only the first file will be processed, assuming it's a PDF file. Processing multiple PDF files from the same field is not supported."),
  );
  $form['instance']['settings']['pdf_to_image']['image_field'] = array(
    '#type' => 'select',
    '#title' => t('Image field'),
    '#description' => t("The field where this file's image(s) will be saved."),
    '#options' => $options,
    '#default_value' => $defaults['image_field'],
    '#empty_option' => '- ' . t('Disabled') . ' -',
  );
  $form['instance']['settings']['pdf_to_image']['hide_image_field'] = array(
    '#type' => 'checkbox',
    '#title' => t('Hide image field'),
    '#description' => t("Hide the image field from edit forms so that images can't be manually uploaded there."),
    '#default_value' => $defaults['hide_image_field'],
    '#states' => $states,
  );
  $form['instance']['settings']['pdf_to_image']['format'] = array(
    '#type' => 'select',
    '#title' => t('Image format'),
    '#description' => t("The file format to save this file's image(s) as. The image field must list the selected format in its 'Allowed file extensions' setting."),
    '#options' => array(
      'jpg' => 'JPG',
      'gif' => 'GIF',
      'png' => 'PNG',
    ),
    '#default_value' => $defaults['format'],
    '#states' => $states,
  );
  $form['instance']['settings']['pdf_to_image']['pdf_to_image_alt_mode'] = array(
    '#type' => 'select',
    '#title' => t('Alt text mode'),
    '#description' => t('Choose how alternative (alt) text is generated for accessibility compliance (e.g. WCAG). This alt text will be saved when the image is generated.'),
    '#options' => array(
      'none' => t('Leave Alone / None'),
      'title' => t('Entity Title / Name'),
      'filename' => t('Source PDF Filename'),
      'token' => t('Custom Token Pattern'),
    ),
    '#default_value' => $defaults['pdf_to_image_alt_mode'],
    '#states' => $states,
  );
  $form['instance']['settings']['pdf_to_image']['pdf_to_image_alt_token'] = array(
    '#type' => 'textfield',
    '#title' => t('Alt text token pattern'),
    '#description' => t('Specify a pattern of tokens to construct the alt text. Example: <code>[node:title]</code>.<br>This field supports tokens: ') .
      theme('token_tree_link', array('token_types' => array($instance['entity_type']))),
    '#default_value' => $defaults['pdf_to_image_alt_token'],
    '#states' => array(
      'visible' => array(
        ':input[name$="[pdf_to_image][pdf_to_image_alt_mode]"]' => array('value' => 'token'),
        ':input[name$="[pdf_to_image][image_field]"]' => array('!value' => ''),
      ),
    ),
  );

  // Hide the button (and its help text below) when no image field is selected,
  // or when the mode is 'none' (in which case existing alt text is left
  // untouched, so there is nothing to update).
  $update_alt_states = array(
    'invisible' => array(
      array(':input[name$="[pdf_to_image][image_field]"]' => array('value' => '')),
      'or',
      array(':input[name$="[pdf_to_image][pdf_to_image_alt_mode]"]' => array('value' => 'none')),
    ),
  );
  $form['instance']['settings']['pdf_to_image']['pdf_to_image_update_alt'] = array(
    '#type' => 'submit',
    '#value' => t('Update existing image Alt text'),
    '#submit' => array('field_ui_field_edit_form_submit', 'pdf_to_image_update_alt_submit'),
    '#access' => !empty($defaults['image_field']),
    '#states' => $update_alt_states,
  );
  // Help text as its own element so #states can hide it alongside the button
  // (a button's #suffix renders as a sibling and would stay visible).
  $form['instance']['settings']['pdf_to_image']['pdf_to_image_update_alt_help'] = array(
    '#type' => 'item',
    '#markup' => '<div class="description">' . t('Clicking this button saves the form settings and then runs the batch update process immediately. Existing images will have their Alt text updated without being regenerated.') . '</div>',
    '#access' => !empty($defaults['image_field']),
    '#states' => $update_alt_states,
  );

  $form['instance']['settings']['pdf_to_image']['options'] = array(
    '#type' => 'fieldset',
    '#title' => t('Options'),
    '#collapsible' => TRUE,
    '#states' => $states,
  );
  $form['instance']['settings']['pdf_to_image']['options']['resolution'] = array(
    '#type' => 'number',
    '#title' => t('Resolution'),
    '#description' => t("The resolution of this file's image(s). NOTE: This is <em>not</em> the image dimensions, but rather a factor by which the image dimensions are calculated (e.g. a resolution of '150' means a PDF page measuring 8x12 inches will produce image dimensions of 1200x1800 pixels)."),
    '#default_value' => $defaults['options']['resolution'],
    '#min' => 1,
    '#max' => 1000,
  );
  $form['instance']['settings']['pdf_to_image']['options']['trim'] = array(
    '#type' => 'checkbox',
    '#title' => t('Trim'),
    '#description' => t("Crop the edges of the image that are the same color as the background."),
    '#default_value' => $defaults['options']['trim'],
  );
}

/**
 * Submit handler for the "Update existing image Alt text" button.
 *
 * Runs the Backdrop Batch API to update alt text of existing image field items.
 */
function pdf_to_image_update_alt_submit($form, &$form_state) {
  $instance = $form['#instance'];
  $entity_type = $instance['entity_type'];
  $bundle = $instance['bundle'];
  $field_name = $instance['field_name'];

  // Query all entities of this type and bundle where the source file field has data.
  $query = new EntityFieldQuery();
  $query->entityCondition('entity_type', $entity_type)
    ->entityCondition('bundle', $bundle)
    ->fieldCondition($field_name, 'fid', 'NULL', '!=');

  $result = $query->execute();

  if (empty($result[$entity_type])) {
    backdrop_set_message(t('No entities found with files uploaded in this field.'));
    return;
  }

  $ids = array_keys($result[$entity_type]);

  $operations = array();
  // Process in chunks of 10 to ensure stability and avoid timeouts.
  $chunks = array_chunk($ids, 10);
  foreach ($chunks as $chunk) {
    $operations[] = array(
      'pdf_to_image_update_alt_batch_op',
      array($entity_type, $chunk),
    );
  }

  $batch = array(
    'title' => t('Updating Alt Text'),
    'operations' => $operations,
    'finished' => 'pdf_to_image_update_alt_batch_finished',
    'file' => backdrop_get_path('module', 'pdf_to_image') . '/pdf_to_image.module',
  );

  batch_set($batch);
}

/**
 * Batch operation callback to load entities and update image Alt text.
 */
function pdf_to_image_update_alt_batch_op($entity_type, $ids, &$context) {
  $entities = entity_load($entity_type, $ids);
  foreach ($entities as $entity) {
    // Saving the entity triggers pdf_to_image_entity_presave(), which
    // updates the alternative text of existing generated images.
    $entity->save();
  }

  if (!isset($context['results']['updated'])) {
    $context['results']['updated'] = 0;
  }
  $context['results']['updated'] += count($ids);
}

/**
 * Batch finished callback.
 */
function pdf_to_image_update_alt_batch_finished($success, $results, $operations) {
  if ($success) {
    $count = isset($results['updated']) ? $results['updated'] : 0;
    backdrop_set_message(t('Successfully updated the alt text for @count entities.', array('@count' => $count)));
  }
  else {
    backdrop_set_message(t('An error occurred during the alt text update process.'), 'error');
  }
}

/**
 * Implements hook_form_alter().
 */
function pdf_to_image_form_alter(&$form, &$form_state, $form_id) {
  // Run only on entity edit forms.
  if (!(isset($form['#entity_type']) && isset($form['#bundle']))) {
    return;
  }

  // Get PDF to Image-enabled fields.
  $file_fields = _pdf_to_image_get_fields($form['#entity_type'], $form['#bundle']);

  // Hide image fields.
  if (!empty($file_fields)) {
    foreach ($file_fields as $file_field) {
      if ($file_field['settings']['pdf_to_image']['hide_image_field']) {
        $image_field = $file_field['settings']['pdf_to_image']['image_field'];
        if (isset($form[$image_field])) {
          $form[$image_field]['#access'] = FALSE;
        }
      }
    }
  }
}

/**
 * Implements hook_entity_presave().
 */
function pdf_to_image_entity_presave($entity, $type) {
  // Get the entity bundle.
  list($id, $vid, $bundle) = entity_extract_ids($type, $entity);

  // Get PDF to Image-enabled fields.
  $file_fields = _pdf_to_image_get_fields($type, $bundle);
  if (empty($file_fields)) {
    return;
  }

  foreach ($file_fields as $file_field) {
    $settings = $file_field['settings']['pdf_to_image'];
    $settings += array(
      'pdf_to_image_alt_mode' => 'none',
      'pdf_to_image_alt_token' => '[node:title]',
    );
    $image_field = $settings['image_field'];

    // Determine the language key to write image field values under. This must
    // match what the Field API uses when reading/saving (LANGUAGE_NONE for
    // non-translatable fields), which is not necessarily $entity->langcode.
    $langcode = field_language($type, $entity, $image_field);

    // Get the old and new file for this field and its associated image field.
    $old_files = array();
    $old_images = array();
    if (!empty($entity->original)) {
      $old_files = field_get_items($type, $entity->original, $file_field['field_name']);
      $old_images = field_get_items($type, $entity->original, $image_field);
    }
    $new_files = field_get_items($type, $entity, $file_field['field_name']);
    $new_images = field_get_items($type, $entity, $image_field);

    // If there are no files here, clear the associated image field and move on.
    if (empty($new_files)) {
      $entity->{$image_field}[$langcode] = array();
      continue;
    }

    // Only process the first file in a multi-valued field, and make sure it's a
    // PDF file.
    $file = file_load($new_files[0]['fid']);
    if ($file->filemime != 'application/pdf') {
      continue;
    }

    // Determine the raw alt text based on settings.
    $raw_alt = '';
    switch ($settings['pdf_to_image_alt_mode']) {
      case 'filename':
        $raw_alt = pathinfo($file->filename, PATHINFO_FILENAME);
        break;

      case 'token':
        // Unsanitized on purpose: backdrop_attributes() runs it through check_plain() on render anyways.
        $raw_alt = token_replace($settings['pdf_to_image_alt_token'], array($type => $entity),
          array('sanitize' => FALSE));
        break;

      case 'none':
        $raw_alt = '';
        break;

      case 'title':
      default:
        if (isset($entity->title)) {
          $raw_alt = $entity->title;
        }
        elseif (isset($entity->name)) {
          $raw_alt = $entity->name;
        }
        break;
    }
    // Truncate and strip HTML tags to prevent DB/markup issues.
    $alt_text = truncate_utf8(strip_tags($raw_alt), 512);

    // Check if this file already exists and, if so, move on.
    if (!empty($old_files) && $file->fid == $old_files[0]['fid'] && !empty($new_images)) {
      // Update alt text on the existing images, unless the mode is 'none', in
      // which case existing alt text is left untouched. An empty alt is better
      // than no alt for a11y, but deleting or overwriting a manually-set one
      // is worse.
      if ($settings['pdf_to_image_alt_mode'] != 'none') {
        foreach ($new_images as $delta => $image_item) {
          $entity->{$image_field}[$langcode][$delta]['alt'] = $alt_text;
        }
      }
      continue;
    }

    // If image(s) have been manually uploaded, don't overwrite them, move on.
    if (empty($old_images) && !empty($new_images)) {
      continue;
    }

    // Clear the associated image field.
    $entity->{$image_field}[$langcode] = array();

    // Get the field array of the image field.
    $image_field_info = field_info_field($image_field);

    // Process the PDF file.
    // Wrap Imagick operations in a try/catch block to prevent any processing errors
    // (e.g., malformed PDF, extension failure, or system memory limits) from
    // throwing a fatal exception and triggering a White Screen of Death (WSOD).
    try {
      $imagick = new imagick();
      $imagick->setResolution($settings['options']['resolution'], $settings['options']['resolution']);

      // Set color space to the most compatible one (esp. for displays)
      // to avoid color shifting.
      $imagick->SetColorspace(Imagick::COLORSPACE_SRGB);

      $imagick->readImage($file->uri);

      // Avoid background of JPG-files being coincidentally converted to black
      // due to possible error of Imagemagick.
      if ($settings['format'] == 'jpg') {
        $imagick->mergeImageLayers(Imagick::LAYERMETHOD_FLATTEN);
        $imagick->setImageAlphaChannel(Imagick::ALPHACHANNEL_REMOVE);
      }

      $imagick->setImageFormat($settings['format']);
      $total = $imagick->getNumberImages();

      // Let the configured number of image field items (cardinality) limit the number of generated images.
      $cardinality = $image_field_info['cardinality'];
      $count = ($cardinality != -1 && $total > $cardinality) ? $cardinality : $total;

      for ($page = 0; $page < $count; $page++) {
        $imagick->setIteratorIndex($page);
        if ($settings['options']['trim']) {
          $imagick->trimImage(0);
        }

        // Get the temporary and final destinations for this image.
        $filename = pathinfo($file->uri, PATHINFO_FILENAME) . '-' . $page . '.' . $settings['format'];
        $temp_destination = file_directory_temp() . '/' . $filename;

        // Use the configured directory of the imagefield as destination.
        $image_field_instance = field_info_instance($type, $image_field, $bundle);
        $image_dir_uri = file_field_widget_uri($image_field_info, $image_field_instance);
        // Create directory on the first run
        file_prepare_directory($image_dir_uri, FILE_CREATE_DIRECTORY);
        // Avoid adding a third slash if it's the files root directory identified by 'public://'.
        if (substr($image_dir_uri, -1) != '/') {
          $image_dir_uri .= '/';
        }
        $final_destination = $image_dir_uri . $filename;

        // Save the image.
        $imagick->writeImage($temp_destination);
        $data = file_get_contents($temp_destination);
        $image = file_save_data($data, $final_destination, FILE_EXISTS_REPLACE);
        $image_array = (array) $image;
        $image_array['alt'] = $alt_text;
        $entity->{$image_field}[$langcode][] = $image_array;
      }
      $imagick->clear();
    }
    catch (Exception $e) {
      // Log the exception in watchdog.
      watchdog('pdf_to_image', 'Error generating images from PDF file %file: %message', array(
        '%file' => $file->uri,
        '%message' => $e->getMessage(),
      ), WATCHDOG_ERROR);

      // Display an admin/user message.
      backdrop_set_message(t('An error occurred while generating images from the PDF file. Please check the site logs for details.'), 'error');
    }
  }
}

/**
 * Get a list of PDF to Image-enabled fields.
 *
 * @param $entity_type
 *   The entity type for which to return fields (e.g. 'node' or 'user').
 * @param $bundle
 *   The bundle name for which to return fields.
 */
function _pdf_to_image_get_fields($entity_type, $bundle) {
  $file_fields = array();

  $fields = field_info_instances($entity_type, $bundle);
  foreach ($fields as $field) {
    if ($field['widget']['type'] == 'file_generic' && !empty($field['settings']['pdf_to_image']['image_field'])) {
      $file_fields[$field['field_name']] = $field;
    }
  }

  return $file_fields;
}

